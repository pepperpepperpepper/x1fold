#!/bin/sh
set -eu

# Prevent motion (accelerometer/Intel HID) from waking the system while it is
# suspended. Relevant to s2idle only -- lid close hibernates (see
# systemd/logind.conf.d/20-x1fold-lid-hibernate.conf).
# See: /usr/local/bin/x1fold-wakeup-guard

case "${1:-}" in
  pre)
    /usr/local/bin/x1fold-wakeup-guard pre >/dev/null 2>&1 || true
    ;;
  post)
    /usr/local/bin/x1fold-wakeup-guard post >/dev/null 2>&1 || true
    ;;
esac

