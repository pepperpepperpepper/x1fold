#!/bin/sh
set -eu

# Reset the Wacom I2C HID device across suspend/resume.
# (Touch/pen can get stuck after fold/unfold if it triggers s2idle.)
#
# Note: We started with *post-only* (resume) to keep this minimally invasive.
# If the -121 spam persists or the device wedges harder, switching to:
#   pre:  unbind
#   post: bind
# is usually more reliable.

case "${1:-}" in
  pre)
    /usr/local/bin/x1fold-wacom-reset pre >/dev/null || true
    ;;
  post)
    /usr/local/bin/x1fold-wacom-reset post >/dev/null || true
    ;;
esac
