#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  exec sudo -- "$0" "$@"
fi

run_timeout() {
  local timeout_s="${X1FOLD_WEBCAM_OFF_TIMEOUT_S:-2}"
  if command -v timeout >/dev/null 2>&1; then
    timeout "${timeout_s}s" "$@" 2>/dev/null || true
  else
    "$@" 2>/dev/null || true
  fi
}

# Stop Chrome bridge if running.
pid_file="${PID_FILE:-/run/x1fold-webcam-chrome.pid}"
if [[ -f "$pid_file" ]]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    sleep 0.2
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file"
fi

run_timeout modprobe -r v4l2loopback

# Best-effort: unload the capture/stream pieces.
# Keep `intel_ipu6`, `ipu_bridge`, and `mei_vsc` loaded once they've been used;
# unloading them can leave the kernel in a bad state on some setups.

run_timeout rmmod -v intel_ipu6_isys
run_timeout rmmod -v intel_ipu6_psys

run_timeout rmmod -v ov5675
run_timeout rmmod -v ivsc_csi
run_timeout rmmod -v ivsc_ace

vsc_power_ctl="/sys/devices/platform/intel_vsc/power/control"
if [[ -w "$vsc_power_ctl" ]]; then
  echo auto >"$vsc_power_ctl" || true
fi

echo "IPU6 webcam stack disabled (core helpers kept loaded)."
echo "Tip: for a full unload/reset, reboot."
